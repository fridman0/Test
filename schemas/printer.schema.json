{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrintHub printer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "manufacturer",
    "model",
    "files"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting-files"
          }
        },
        "required": [
          "status"
        ]
      },
      "else": {
        "properties": {
          "files": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manufacturer": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "awaiting-files"
      ]
    },
    "series": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "enum": [
        "monochrome",
        "color"
      ]
    },
    "manualUrl": {
      "type": "string",
      "pattern": "^https://oip\\.manual\\.canon/"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "checkedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "targetOperatingSystems": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows-10-x64",
          "windows-11-x64",
          "linux-x86_64"
        ]
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "driverCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageId",
          "vendorModel",
          "verification"
        ],
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "vendorModel": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "vendor-listed",
              "regional-name-match-needs-review"
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "os",
          "osVersions",
          "architecture",
          "version",
          "filename",
          "sizeBytes",
          "sha256",
          "downloadUrl",
          "sourceUrl",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "driver",
              "ppd"
            ]
          },
          "os": {
            "enum": [
              "windows",
              "linux",
              "macos"
            ]
          },
          "osVersions": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "architecture": {
            "enum": [
              "x86",
              "x86_64",
              "arm64",
              "any"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "downloadUrl": {
            "type": "string",
            "pattern": "^https://github\\.com/fridman0/Test/releases/download/[^/?#]+/[^/?#]+$"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "extracted-not-print-tested"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "ppdModelName": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
